{
    "version": "0.2.0",
    "configurations": [
        {
            "preLaunchTask": "cargo: build",
            "type": "baker-link-debug",
            "request": "launch",
            "name": "Baker Link: Debug",
            "bakerLink": {
                "dapServer": "host.docker.internal:50001",
                "uploadUrl": "http://host.docker.internal:50002",
                "elf": "${workspaceFolder}/target/thumbv6m-none-eabi/debug/atome_lm_rs"
            },
            "remoteServerMode": false,
            "speed": 4000,
            "chip": "RP2040",
            "flashingConfig": {
                "flashingEnabled": true,
                "haltAfterReset": true,
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "bakerlink://atome_lm_rs/debug",
                    "rttEnabled": true,
                }
            ],
            "env": {
                "RUST_LOG": "info"
            },
            "consoleLogLevel": "Info"
        }
    ]
}